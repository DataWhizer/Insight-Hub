-- ============================================================
-- 1. CUSTOMER SEGMENTATION — RFM (Recency, Frequency, Monetary)
-- ============================================================
-- Segments customers by how recently they bought, how often,
-- and how much they spent in total.

WITH rfm AS (
    SELECT
        c.customer_id,
        c.first_name,
        c.last_name,

        -- Days since the customer's most recent order
        DATEDIFF(DAY, MAX(o.order_date), GETDATE()) AS recency,

        -- Total number of orders placed
        COUNT(o.order_id)                           AS frequency,

        -- Total spend across all orders
        SUM(o.total_amount)                         AS monetary

    FROM Orders o
    JOIN Customers c ON o.customer_id = c.customer_id
    GROUP BY c.customer_id, c.first_name, c.last_name
)
SELECT
    customer_id,
    first_name,
    last_name,

    -- Recency segment: how recently did the customer buy?
    CASE
        WHEN recency <= 30 THEN 'Active'    -- bought within the last month
        WHEN recency <= 90 THEN 'Engaged'   -- bought within the last quarter
        ELSE 'Churned'                      -- no purchase in over 90 days
    END AS recency_segment,

    -- Frequency segment: how often does the customer buy?
    CASE
        WHEN frequency >= 10 THEN 'High Frequency'
        WHEN frequency >= 5  THEN 'Medium Frequency'
        ELSE 'Low Frequency'
    END AS frequency_segment,

    -- Monetary segment: how much has the customer spent?
    CASE
        WHEN monetary >= 500 THEN 'High Spender'
        WHEN monetary >= 100 THEN 'Medium Spender'
        ELSE 'Low Spender'
    END AS monetary_segment

FROM rfm;


-- ============================================================
-- 2. SALES FORECASTING — 3-Month Moving Average
-- ============================================================
-- Aggregates revenue by month, then smooths it with a rolling
-- 3-month average to reveal trend direction.

WITH monthly_sales AS (
    SELECT
        YEAR(order_date)  AS year,
        MONTH(order_date) AS month,
        SUM(total_amount) AS monthly_sales
    FROM Orders
    GROUP BY YEAR(order_date), MONTH(order_date)
)
SELECT
    year,
    month,
    monthly_sales,

    -- Rolling average of the current month plus the two preceding months.
    -- Smooths out spikes to expose the underlying sales trend.
    AVG(monthly_sales) OVER (
        ORDER BY year, month
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
    ) AS moving_avg_sales

FROM monthly_sales
ORDER BY year, month; -- explicit sort ensures window frame is applied correctly


-- ============================================================
-- 3. PRICING OPTIMIZATION — Price Elasticity
-- ============================================================
-- Measures how sensitive demand is to price changes.
-- Elasticity < -1  = elastic   (buyers respond strongly to price changes)
-- Elasticity > -1  = inelastic (buyers are relatively price-insensitive)
--
-- NOTE: AVG(p.price) assumes price can vary per order (e.g. discounts).
-- If Products.price is a fixed column, replace AVG(p.price) with MAX(p.price)
-- or pull price from your order line-items table instead.

WITH product_sales AS (
    -- Step 1: aggregate revenue and volume per product
    SELECT
        p.product_id,
        p.product_name,
        AVG(p.price)        AS avg_price,
        SUM(o.quantity)     AS total_quantity,
        SUM(o.total_amount) AS total_revenue
    FROM Orders o
    JOIN Products p ON o.product_id = p.product_id
    GROUP BY p.product_id, p.product_name
),
price_lag AS (
    -- Step 2: pull in the previous product's price and quantity using LAG.
    -- Ordering by product_id is arbitrary — replace with a meaningful sort
    -- (e.g. a date column) if you have time-series pricing data.
    SELECT
        product_id,
        product_name,
        avg_price,
        total_quantity,
        LAG(avg_price)      OVER (ORDER BY product_id) AS prev_price,
        LAG(total_quantity) OVER (ORDER BY product_id) AS prev_quantity
    FROM product_sales
)
-- Step 3: compute percentage changes and elasticity.
-- NULLIF(..., 0) guards against divide-by-zero errors.
SELECT
    product_id,
    product_name,
    avg_price,
    total_quantity,
    prev_price,
    prev_quantity,

    -- % change in price vs the previous product
    ((avg_price     - prev_price)     / NULLIF(prev_price,     0.0)) * 100 AS price_change_pct,

    -- % change in quantity sold vs the previous product
    ((total_quantity - prev_quantity) / NULLIF(prev_quantity, 0.0)) * 100 AS quantity_change_pct,

    -- Price elasticity = % quantity change / % price change
    -- Returns NULL when there is no price change (avoid division by zero)
    -- or when prior-period data is missing/zero.
    CASE
        WHEN prev_price    IS NULL OR prev_price    = 0 THEN NULL
        WHEN prev_quantity IS NULL OR prev_quantity = 0 THEN NULL
        WHEN avg_price = prev_price                     THEN NULL -- no price movement
        ELSE (
            ((total_quantity - prev_quantity) / NULLIF(prev_quantity, 0.0))
            /
            NULLIF((avg_price - prev_price)   / NULLIF(prev_price,   0.0), 0)
        )
    END AS price_elasticity

FROM price_lag
-- Filter out rows with no prior period to compare against
WHERE prev_price    IS NOT NULL
  AND prev_quantity IS NOT NULL;


-- ============================================================
-- 4. RECOMMENDATION SYSTEM — Frequently Bought Together
-- ============================================================
-- Identifies product pairs that appear in the same order often.
-- These pairs can drive "customers also bought" recommendations.

WITH product_combinations AS (
    SELECT
        o1.product_id AS product_1,
        o2.product_id AS product_2
    FROM Orders o1
    JOIN Orders o2
      ON  o1.order_id   = o2.order_id     -- same order
      AND o1.product_id < o2.product_id   -- ensures each pair appears once only
)
SELECT
    product_1,
    product_2,
    COUNT(*) AS combination_count   -- how many orders contained both products
FROM product_combinations
GROUP BY product_1, product_2
ORDER BY combination_count DESC;    -- highest co-occurrence pairs at the top

