Project: Analysis of Happiest Countries

Overview: This project aims to analyze the happiest countries based on various socioeconomic and well-being factors. 
          The dataset used is derived from the World Happiness Report, which measures happiness in terms of life 
          expectancy, GDP per capita, social support, freedom to make life choices, generosity, and perceptions of corruption.

============================================================
 
CREATE DATABASE IF NOT EXISTS happiest_countries_db;
 
USE happiest_countries_db;
 
-- Create the main happiness data table
CREATE TABLE IF NOT EXISTS country_happiness (
    country_id               INT            AUTO_INCREMENT PRIMARY KEY,
    country_name             VARCHAR(100)   NOT NULL,                  -- tightened from VARCHAR(255)
    year                     INT            NOT NULL,
    happiness_rank           INT,
    -- BUG FIX: DECIMAL(3,2) only stores up to 9.99 with 2 decimal places.
    -- Values like 7.842 were silently rounded to 7.84.
    -- DECIMAL(5,3) allows up to 99.999, safely covering all happiness scores.
    happiness_score          DECIMAL(5, 3),
    GDP_per_capita           DECIMAL(5, 4),
    social_support           DECIMAL(5, 4),
    healthy_life_expectancy  DECIMAL(5, 4),
    freedom_to_make_choices  DECIMAL(5, 4),
    generosity               DECIMAL(5, 4),
    perceptions_of_corruption DECIMAL(5, 4),
    region                   VARCHAR(100)                              -- tightened from VARCHAR(255)
);
 
 
-- ============================================================
-- INDEXES
-- ============================================================
-- Every analytical query below filters on `year`, so a composite
-- index on (year, happiness_rank) and (year, happiness_score) covers
-- the most common query patterns without redundant scans.
 
-- Single-column index on year for simple WHERE year = ? filters
CREATE INDEX idx_ch_year
    ON country_happiness (year);
 
-- Composite index for "top N by rank in a given year" queries
CREATE INDEX idx_ch_year_rank
    ON country_happiness (year, happiness_rank);
 
-- Composite index for score-based filters and aggregations
CREATE INDEX idx_ch_year_score
    ON country_happiness (year, happiness_score);
 
-- Index on region for GROUP BY region queries
CREATE INDEX idx_ch_region
    ON country_happiness (region);
 
 
