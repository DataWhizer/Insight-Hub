-- ============================================================
-- DATA QUALITY — NULL CHECK
-- ============================================================
-- Identify rows with missing values in critical columns.
 
SELECT *
FROM country_happiness
WHERE country_name            IS NULL
   OR happiness_score         IS NULL
   OR GDP_per_capita          IS NULL;
 
 
-- ============================================================
-- DATA QUALITY — IMPUTE MISSING CORRUPTION SCORES
-- ============================================================

UPDATE country_happiness
SET perceptions_of_corruption = (
    SELECT avg_val
    FROM (
        SELECT AVG(perceptions_of_corruption) AS avg_val
        FROM country_happiness
        WHERE perceptions_of_corruption IS NOT NULL
    ) AS corruption_avg  -- derived table alias required by MySQL
)
WHERE perceptions_of_corruption IS NULL;
 
 
-- ============================================================
-- ANALYSIS 1: Top 10 Happiest Countries (2021)
-- ============================================================
-- Returns the 10 countries with the highest happiness rank for 2021.
-- The index on (year, happiness_rank) makes this a fast index scan.
 
SELECT
    country_name,
    happiness_rank,
    happiness_score
FROM country_happiness
WHERE year = 2021
ORDER BY happiness_rank ASC
LIMIT 10;
 
 
-- ============================================================
-- ANALYSIS 2: Average Happiness Score by Region (2021)
-- ============================================================
-- Aggregates scores by region to compare continental well-being.
-- Useful for identifying which parts of the world consistently score higher and why.
 
SELECT
    region,
    ROUND(AVG(happiness_score), 3) AS avg_happiness_score  -- rounded for readability
FROM country_happiness
WHERE year = 2021
GROUP BY region
ORDER BY avg_happiness_score DESC;
 
 
-- ============================================================
-- ANALYSIS 3: GDP per Capita vs. Happiness Score (2021)
-- ============================================================
-- Raw data for scatter-plot analysis or correlation modelling.
-- A positive correlation here suggests wealthier nations tend to report higher happiness — but this is not causal on its own.
 
SELECT
    country_name,         -- added for context; helps identify outliers
    GDP_per_capita,
    happiness_score
FROM country_happiness
WHERE year = 2021
ORDER BY GDP_per_capita DESC;  -- sorted so high-GDP countries appear first
 
 
-- ============================================================
-- ANALYSIS 4: Social Support vs. Happiness (2021)
-- ============================================================
-- Countries with stronger social safety nets tend to score higher.
-- Sort descending to see whether high social support reliably maps to high happiness scores.
 
SELECT
    country_name,         -- added for context
    social_support,
    happiness_score
FROM country_happiness
WHERE year = 2021
ORDER BY social_support DESC;
 
 
-- ============================================================
-- ANALYSIS 5: Low Corruption + High Happiness (2021)
-- ============================================================
-- Finds countries that combine low perceived corruption with high happiness scores — a useful proxy for institutional quality.
-- Thresholds (corruption < 0.200, happiness > 6.5) are based on the dataset distribution
 
SELECT
    country_name,
    happiness_score,
    perceptions_of_corruption
FROM country_happiness
WHERE year = 2021
  AND perceptions_of_corruption < 0.200
  AND happiness_score > 6.5
ORDER BY happiness_score DESC;
 
 
-- ============================================================
-- VIEW: Happiness Factors by Region (all years)
-- ============================================================

SELECT * FROM happiness_factors_by_region WHERE year = 2021;
 
CREATE OR REPLACE VIEW happiness_factors_by_region AS
SELECT
    year,                                                -- now part of the key
    region,
    ROUND(AVG(GDP_per_capita),           4) AS avg_GDP_per_capita,
    ROUND(AVG(social_support),           4) AS avg_social_support,
    ROUND(AVG(healthy_life_expectancy),  4) AS avg_life_expectancy,
    ROUND(AVG(freedom_to_make_choices),  4) AS avg_freedom,
    ROUND(AVG(generosity),               4) AS avg_generosity,
    ROUND(AVG(perceptions_of_corruption),4) AS avg_corruption
FROM country_happiness
GROUP BY year, region;
 
 
-- ============================================================
-- ANALYSIS 6: Regions with Highest Life Expectancy (2021)
-- ============================================================

SELECT
    region,
    avg_life_expectancy
FROM happiness_factors_by_region
WHERE year = 2021
ORDER BY avg_life_expectancy DESC;
 
 
